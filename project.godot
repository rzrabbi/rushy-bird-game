[application]

config/name="Rushy Bird"
config/description="A fast-paced 2D Rushy Bird game featuring dynamic speed escalation, persistent high scores, and mobile-friendly touch controls."
run/main_scene="res://scenes/Main.tscn"
boot_splash/image="res://assets/brand/splash.png"
boot_splash/bg_color=Color( 0.0784314, 0.0784314, 0.0784314, 1 )
config/icon="res://assets/brand/icon.png"
config/windows_native_icon="res://assets/brand/rushy_bird.ico"
config/version="1.0"

[audio]

mix_rate.web=44100
driver/output_latency.web=50

[autoload]

Global="*res://scripts/Global.gd"
Console="*res://addons/console/Console.gd"
Anima="*res://addons/anima/core/anima.gd"
Firebase="*res://addons/godot-firebase/firebase/firebase.tscn"
FirebaseManager="*res://scripts/FirebaseManager.gd"
JavascriptManager="*res://addons/WebAudioExternal/JavascriptManager.gd"
AudioManager="*res://addons/WebAudioExternal/AudioManager.gd"

[display]

window/size/width=1080
window/size/height=1920
window/size/resizable=false
window/size/test_width=422
window/size/test_height=750
window/dpi/allow_hidpi=true
window/handheld/orientation="portrait"
window/stretch/mode="2d"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PoolStringArray( "res://addons/FontAwesome5/plugin.cfg", "res://addons/WebAudioExternal/plugin.cfg", "res://addons/anima/plugin.cfg", "res://addons/build-tracker/plugin.cfg", "res://addons/console/plugin.cfg", "res://addons/godot-firebase/plugin.cfg", "res://addons/gut/plugin.cfg", "res://addons/http-sse-client/plugin.cfg", "res://addons/local-server/plugin.cfg", "res://addons/onscreenkeyboard/plugin.cfg" )

[gui]

common/drop_mouse_on_gui_input_disabled=true

[input]

Jump={
"deadzone": 0.5,
"events": [ Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":0,"alt":false,"shift":false,"control":false,"meta":false,"command":false,"pressed":false,"scancode":32,"physical_scancode":0,"unicode":0,"echo":false,"script":null)
, Object(InputEventMouseButton,"resource_local_to_scene":false,"resource_name":"","device":0,"alt":false,"shift":false,"control":false,"meta":false,"command":false,"button_mask":0,"position":Vector2( 0, 0 ),"global_position":Vector2( 0, 0 ),"factor":1.0,"button_index":1,"canceled":false,"pressed":false,"doubleclick":false,"script":null)
 ]
}

[input_devices]

pointing/emulate_touch_from_mouse=true

[network]

limits/tcp/connect_timeout_seconds=10

[physics]

common/enable_pause_aware_picking=true

[rendering]

quality/driver/driver_name="GLES2"
2d/snapping/use_gpu_pixel_snap=true
vram_compression/import_etc=true
environment/default_environment="res://resources/default_env.tres"
